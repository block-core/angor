<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fp="clr-namespace:App.UI.Sections.FindProjects"
             xmlns:deploy="clr-namespace:App.UI.Sections.MyProjects.Deploy"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="App.UI.Sections.FindProjects.InvestPageView"
             x:DataType="fp:InvestPageViewModel">

    <!--
        InvestPage — Vue ref: InvestPage.vue (2984 lines)
        Layout: fixed nav bar (top) + fixed footer (bottom) + scrollable 3-column grid
        Supports: Investment (BTC amount input) and Subscription (plan selection cards)
        Modals: Wallet Selector → Invoice/QR → Success (overlays on top)
    -->

    <UserControl.Styles>
        <!-- Vue: .back-button-floating hover → translateY(-1px) + enhanced shadow -->
        <Style Selector="Border.BackButton:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px, -1px)" />
            <Setter Property="BoxShadow" Value="0 6 16 0 #33000000" />
        </Style>
        <Style Selector="Border.FloatingBtn:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px, -1px)" />
            <Setter Property="BoxShadow" Value="0 6 16 0 #33000000" />
        </Style>
        <!-- Kill FluentTheme button chrome on the back button -->
        <Style Selector="Button.BackBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.BackBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.BackBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Subscription plan button default state (via style, not inline) -->
        <Style Selector="Button.SubPlanBtn">
            <Setter Property="Background" Value="{DynamicResource SubPlanBtnBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubPlanBtnBorder}" />
        </Style>
        <!-- Subscription plan button hover (Vue: border-color #9e9e9e, bg #f9fafb / dark #2a2a2a) -->
        <Style Selector="Button.SubPlanBtn:pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SubPlanBtnHoverBorder}" />
            <Setter Property="Background" Value="{DynamicResource SubPlanBtnHoverBg}" />
        </Style>
        <!-- Subscription plan button selected state -->
        <Style Selector="Button.SubPlanBtn.SubPlanSelected">
            <Setter Property="Background" Value="{DynamicResource SubPlanBtnSelectedBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubPlanBtnSelectedBorder}" />
        </Style>
        <Style Selector="Button.FundPatternBtn.SubPlanSelected">
            <Setter Property="Background" Value="{DynamicResource PillOrangeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BitcoinOrange}" />
        </Style>
        <Style Selector="Border.WarmMobileCard">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatsDetailCardBorder}" />
        </Style>
        <Style Selector="fp|InvestPageView.Mobile Border.WarmMobileCard">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource BitcoinOrange}" />
        </Style>
        <!-- Quick amount button default state (via style, not inline) -->
        <Style Selector="Button.QuickAmountBtn">
            <Setter Property="Background" Value="{DynamicResource StatsDetailInnerBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatsDetailInnerBorder}" />
        </Style>
        <!-- Quick amount: selected = brand green bg + border, white text (same both themes) -->
        <Style Selector="Button.QuickAmountBtn.QuickAmountSelected">
            <Setter Property="Background" Value="#2D5A3D" />
            <Setter Property="BorderBrush" Value="#2D5A3D" />
        </Style>
        <!-- Quick amount: text colors follow parent selection state -->
        <Style Selector="Button.QuickAmountBtn TextBlock.QuickAmountValue">
            <Setter Property="Foreground" Value="{DynamicResource StatsDetailValue}" />
        </Style>
        <Style Selector="Button.QuickAmountBtn.QuickAmountSelected TextBlock.QuickAmountValue">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.QuickAmountBtn TextBlock.QuickAmountLabel">
            <Setter Property="Foreground" Value="{DynamicResource StatsDetailLabel}" />
        </Style>
        <Style Selector="Button.QuickAmountBtn.QuickAmountSelected TextBlock.QuickAmountLabel">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Disabled submit button: dim + no cursor -->
        <Style Selector="Button#SubmitButton:disabled">
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Border#MobileSubmitButton[IsEnabled=False]">
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- FIXED NAV BAR (top, ZIndex=100)                        -->
        <!-- Vue: sticky top-0, z-index:100, transparent bg          -->
        <!-- Subscription: hides right-side stats pills              -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <DockPanel Name="NavBar"
                   VerticalAlignment="Top"
                   ZIndex="100"
                   Margin="24,24,24,0"
                   IsHitTestVisible="True">

            <!-- LEFT: Back Button (standardized pattern) -->
            <Border DockPanel.Dock="Left"
                    Classes="BackButton"
                    Background="{DynamicResource FloatingBtnBg}"
                    BorderBrush="{DynamicResource FloatingBtnBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="{DynamicResource FloatingBtnShadow}"
                    Padding="16,0,16,0"
                    Height="44"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    RenderTransform="translate(0px, 0px)">
                <Border.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                    </Transitions>
                </Border.Transitions>
                <Button Name="BackButton"
                        Classes="BackBtn"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="10" Height="16">
                            <Path Data="{StaticResource ChevronLeftThick}"
                                  Fill="{DynamicResource TextStrong}"
                                  Width="320" Height="512" Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock Classes="Size-S" Text="Back"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextStrong}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <!-- RIGHT: Stats pills (Total Raised + Progress as separate cards) — HIDDEN for subscription -->
            <!-- Vue: two separate .nav-stat-item divs with gap: 16px -->
            <StackPanel Name="NavStatsPills"
                        DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsNotSubscription}">
                <!-- Total Raised pill -->
                <Border Classes="FloatingBtn"
                        Background="{DynamicResource FloatingBtnBg}"
                        BorderBrush="{DynamicResource FloatingBtnBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="{DynamicResource FloatingBtnShadow}"
                        Padding="20,0"
                        Height="44"
                        RenderTransform="translate(0px, 0px)">
                    <Border.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="Size-13" Text="{Binding Project.RaisedNoun, StringFormat='{}{0}:'}" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Classes="Size-13" Text="{Binding RaisedWithSymbol}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextStrong}" />
                    </StackPanel>
                </Border>
                <!-- Progress pill -->
                <Border Classes="FloatingBtn"
                        Background="{DynamicResource FloatingBtnBg}"
                        BorderBrush="{DynamicResource FloatingBtnBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="{DynamicResource FloatingBtnShadow}"
                        Padding="20,0"
                        Height="44"
                        RenderTransform="translate(0px, 0px)">
                    <Border.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="Size-13" Text="Progress:" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Classes="Size-13" Text="{Binding Project.Progress, StringFormat='{}{0}%'}" FontWeight="Bold"
                                   Foreground="{DynamicResource StageAmountGreen}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CENTER: Project Name pill (left-aligned, next to back button) -->
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="{DynamicResource FloatingBtnShadow}"
                    Padding="16,0,16,0"
                    Height="44"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <TextBlock Classes="Size-S" Text="{Binding Project.ProjectName}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextStrong}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="400"
                           VerticalAlignment="Center" ToolTip.Tip="{Binding Project.ProjectName}" />
            </Border>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- FIXED FOOTER BAR (bottom, ZIndex=100)                   -->
        <!-- Vue: sticky bottom-0, bg white, border-top, shadow      -->
        <!-- Subscription: "Plan: N payments of X Sats" + Subscribe  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Name="FooterBar"
               VerticalAlignment="Bottom"
               ZIndex="100"
               Padding="24,16"
               CornerRadius="16,16,0,0"
               BorderThickness="0,1,0,0"
               BorderBrush="{DynamicResource Stroke}"
                Background="{DynamicResource CardSurface}"
                BoxShadow="0 -4 12 0 #14000000"
                IsVisible="False">
            <!-- Vue: .footer-content { justify-content: flex-end } -->
            <StackPanel Orientation="Horizontal" Spacing="24"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        MaxWidth="1400">

                <!-- Vue: .footer-summary { display: flex; gap: 32px } -->
                <StackPanel Orientation="Horizontal" Spacing="32"
                            VerticalAlignment="Center">
                    <!-- Total (incl. fees) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="Size-S" Text="Total (incl. fees):" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="Size-M" Text="{Binding TotalAmount}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextStrong}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Stages/Plan summary -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="Size-S" Text="{Binding StagesLabel}" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="Size-M" Text="{Binding StagesSummary}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextStrong}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Penalty threshold indicator -->
                <Panel IsVisible="{Binding HasPenaltyThreshold}" VerticalAlignment="Center">
                    <!-- Above threshold: requires founder approval -->
                    <Border IsVisible="{Binding IsAbovePenaltyThreshold}"
                            Padding="8,4" CornerRadius="4"
                            Background="{DynamicResource WarningSoftBrush}">
                        <TextBlock Classes="Size-13" Text="Requires Approval" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrightBrush}" />
                    </Border>
                    <!-- Below threshold: direct publish -->
                    <Border IsVisible="{Binding !IsAbovePenaltyThreshold}"
                            Padding="8,4" CornerRadius="4"
                            Background="#302D5A3D">
                        <TextBlock Classes="Size-13" Text="No Approval Needed" FontWeight="SemiBold"
                                   Foreground="#2D5A3D" />
                    </Border>
                </Panel>

                <!-- Submit button -->
                <Button Name="SubmitButton" Classes="Unstyled"
                        AutomationProperties.AutomationId="InvestSubmitButton"
                        CornerRadius="8" Padding="32,14"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CanSubmit}"
                        IsHitTestVisible="{Binding CanSubmit}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="{StaticResource PrimaryGreen}" Offset="0" />
                            <GradientStop Color="#3d6448" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <!-- Investment: Bitcoin icon, Subscription: RefreshArrows icon -->
                        <i:Icon Value="fa-brands fa-bitcoin"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsNotSubscription}" />
                        <i:Icon Value="fa-solid fa-arrows-rotate" FontSize="18"
                               Foreground="White" VerticalAlignment="Center"
                               IsVisible="{Binding IsSubscription}" />
                        <TextBlock Classes="Size-M" Text="{Binding Project.ActionButtonText}" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SCROLLABLE CONTENT (fills entire area, scrolls under    -->
        <!-- nav bar and footer via spacers)                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ScrollViewer Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Top spacer: nav top margin (24) + nav height (44) + gap (24) = 92px -->
                <Panel Name="TopSpacer" Height="92" />

                <!-- ── MOBILE HEADER STATS (hidden on desktop, shown on compact) ── -->
                <!-- Vue: .invest-header-stats { grid 3 cols, gap 8px, padding 0 16px, mb 1.5rem } -->
                <UniformGrid Name="MobileHeaderStats" Columns="3" Margin="16,0,16,24"
                             IsVisible="False">
                    <!-- Target Amount -->
                    <Border CornerRadius="12" Padding="12,8" Margin="4"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            IsVisible="{Binding IsNotSubscription}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Classes="Size-10" Text="Target Amount" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="Size-M" Text="{Binding Project.Target, StringFormat='{}{0} BTC'}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrong}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Total Raised -->
                    <Border CornerRadius="12" Padding="12,8" Margin="4"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            IsVisible="{Binding IsNotSubscription}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Classes="Size-10" Text="{Binding Project.RaisedNoun}" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="Size-M" Text="{Binding Project.Raised, StringFormat='{}{0} BTC'}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrong}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Progress -->
                    <Border CornerRadius="12" Padding="12,8" Margin="4"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            IsVisible="{Binding IsNotSubscription}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Classes="Size-10" Text="Progress" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="Size-M" Text="{Binding Project.Progress, StringFormat='{}{0}%'}" FontWeight="Bold"
                                       Foreground="{DynamicResource StageAmountGreen}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ── 3-COLUMN CONTENT GRID ── -->
                <!-- Vue: grid-template-columns: repeat(3, 1fr), gap 24px -->
                <!-- No MaxWidth — columns stretch to fill available space -->
                <Grid Name="ContentGrid"
                      ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto"
                      HorizontalAlignment="Stretch"
                      Margin="24,0,24,24">
                    <Grid.ColumnSpacing>24</Grid.ColumnSpacing>
                    <Grid.RowSpacing>24</Grid.RowSpacing>

                    <!-- ════════════════════════════════════════════ -->
                    <!-- COLUMN 1: Investment Amount Card (invest)    -->
                    <!--           OR Subscription Plan Card (sub)    -->
                    <!--           + Funding Pattern selector (fund)  -->
                    <!-- ════════════════════════════════════════════ -->
                    <StackPanel Grid.Column="0" Spacing="24">

                    <!-- ── INVESTMENT AMOUNT (shown for invest/fund) ── -->
                    <!-- Vue: linear-gradient(to bottom right, #fff7ed, #fef3c7), border #fed7aa -->
                    <Border Name="AmountCard" Grid.Column="0"
                            Classes="WarmMobileCard"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource StatsDetailCardBackground}"
                            IsVisible="{Binding IsNotSubscription}">
                        <StackPanel Spacing="20">
                            <!-- Header: Bitcoin icon + title -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <!-- Vue: 40x40, bg #f97316, border-radius 8px -->
                                <Border Width="40" Height="40" CornerRadius="8"
                                        Background="{DynamicResource WarningBrush}">
                                    <i:Icon Value="fa-brands fa-bitcoin"
                                           FontSize="20"
                                           Foreground="White" />
                                </Border>
                                <TextBlock Classes="Size-L" Text="Investment Amount" FontWeight="Bold"
                                           Foreground="{DynamicResource StatsDetailLabel}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Amount input field -->
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Size-S" Text="{Binding AmountLabel}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatsDetailLabel}" />
                                <!-- Vue: padding 12px 16px, border 1px solid #e0e0e0, border-radius 8px, font-size 16px -->
                                <Panel>
                                    <TextBox Name="AmountInput"
                                             AutomationProperties.AutomationId="InvestAmountInput"
                                             Text="{Binding InvestmentAmount, Mode=TwoWay}"
                                             Watermark="0.00000000"
                                             FontSize="16" Padding="12,12,60,12"
                                             CornerRadius="8" />
                                    <!-- BTC suffix: Vue absolute right 16px -->
                                    <TextBlock Classes="Size-S" Text="{Binding CurrencySymbol}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                </Panel>
                                <TextBlock Classes="Size-13" Text="{Binding MinInvestmentHint}"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>

                            <!-- Quick amounts: Vue grid 4 columns, gap 8px -->
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Size-S" Text="Quick amounts" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatsDetailLabel}" />
                                <ItemsControl ItemsSource="{Binding QuickAmounts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="fp:QuickAmountOption">
                                            <!-- Vue: padding 10px 12px, bg #f9fafb, border 1px solid #e5e7eb, border-radius 8px -->
                                            <Button Name="QuickAmountButton" Classes="Unstyled QuickAmountBtn"
                                                    CornerRadius="8" Padding="10,8" Margin="4"
                                                    Cursor="Hand"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    BorderThickness="1"
                                                    CommandParameter="{Binding}">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                                    <TextBlock Classes="QuickAmountValue Size-15"
                                                               Text="{Binding AmountText}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center" ToolTip.Tip="{Binding AmountText}" />
                                                    <TextBlock Classes="QuickAmountLabel Size-XXS"
                                                               Text="{Binding Label}" FontWeight="Medium"
                                                               Opacity="0.7"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── FUNDING PATTERN SELECTOR (shown for fund type with patterns) ── -->
                    <Border Classes="WarmMobileCard"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource StatsDetailCardBackground}"
                            IsVisible="{Binding ShowFundingPatternSelector}">
                        <StackPanel Spacing="20">
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="40" Height="40" CornerRadius="8"
                                        Background="{DynamicResource WarningBrush}">
                                    <i:Icon Value="fa-solid fa-calendar-days" FontSize="18"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Classes="Size-L" Text="Funding Pattern" FontWeight="Bold"
                                           Foreground="{DynamicResource StatsDetailLabel}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Classes="Size-13" Text="Select which instalment schedule to use:"
                                       Foreground="{DynamicResource TextMuted}" />

                            <!-- Pattern options -->
                            <ItemsControl ItemsSource="{Binding FundingPatterns}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fp:FundingPatternOption">
                                        <Button Name="FundPatternButton" Classes="Unstyled SubPlanBtn FundPatternBtn"
                                                CornerRadius="12" Padding="16"
                                                Cursor="Hand"
                                                BorderThickness="2"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="4">
                                                <Panel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Classes="Size-M" Text="{Binding Name}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SubPlanLabel}" />
                                                        <Border CornerRadius="10" Padding="8,2"
                                                                 Background="{DynamicResource PillOrangeBg}">
                                                            <TextBlock Classes="FundPatternStageCount Size-XS" FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource PillOrangeText}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} stages">
                                                                        <Binding Path="StageCount" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="Size-S" Text="{Binding FrequencyText}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SubPlanPrice}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Panel>
                                                <TextBlock Classes="Size-13" Text="{Binding Description}"
                                                           Foreground="{DynamicResource SubPlanDescription}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── SUBSCRIPTION PLAN (shown for subscription type) ── -->
                    <!-- Vue: .subscription-card { background: linear-gradient(to bottom right, #fff7ed, #fef3c7) } -->
                    <!-- Same warm gradient as investment card but with subscription-specific content -->
                    <Border Name="SubscriptionCard" Grid.Column="0"
                            Classes="WarmMobileCard"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource StatsDetailCardBackground}"
                            IsVisible="{Binding IsSubscription}">
                        <StackPanel Spacing="20">
                            <!-- Header: Recurring arrows icon + "Subscription Plan" -->
                            <!-- Vue: .subscription-icon-circle (40x40, bg #f97316, border-radius 8px) -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="40" Height="40" CornerRadius="8"
                                        Background="{DynamicResource WarningBrush}">
                                    <i:Icon Value="fa-solid fa-arrows-rotate" FontSize="18"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Vue: .subscription-card-title { color: #7c2d12 } / dark { color: #fb923c } -->
                                <TextBlock Classes="Size-L" Text="Subscription Plan" FontWeight="Bold"
                                           Foreground="{DynamicResource SubCardTitle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Vue: .subscription-patterns { flex-direction: column; gap: 12px; margin-top: 8px } -->
                            <ItemsControl ItemsSource="{Binding SubscriptionPlans}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fp:SubscriptionPlanOption">
                                        <!--
                                            Vue: .subscription-pattern-btn
                                            padding: 16px, bg: white, border: 2px solid #e5e7eb,
                                            border-radius: 12px, cursor: pointer, transition: all 0.2s
                                        -->
                                        <Button Name="SubPlanButton" Classes="Unstyled SubPlanBtn"
                                                CornerRadius="12" Padding="16"
                                                Cursor="Hand"
                                                BorderThickness="2"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="4">
                                                <!-- Vue: .pattern-header { flex, space-between, center } -->
                                                <Panel>
                                                    <!-- Vue: .pattern-label { font-size: 16px; font-weight: 700 } -->
                                                    <TextBlock Classes="Size-M" Text="{Binding Label}" FontWeight="Bold"
                                                               Foreground="{DynamicResource SubPlanLabel}"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" />
                                                    <!-- Vue: .pattern-price { font-size: 16px; font-weight: 700; color: #9e9e9e } -->
                                                    <TextBlock Classes="Size-M" Text="{Binding PriceText}" FontWeight="Bold"
                                                               Foreground="{DynamicResource SubPlanPrice}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Panel>
                                                <!-- Vue: .pattern-description { font-size: 13px; color: #6b7280 } -->
                                                <TextBlock Classes="Size-13" Text="{Binding Description}"
                                                           Foreground="{DynamicResource SubPlanDescription}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    </StackPanel> <!-- end Column 0 StackPanel -->

                    <!-- ════════════════════════════════════════════ -->
                    <!-- COLUMN 2: Release Schedule / Payment Schedule -->
                    <!-- Vue: linear-gradient(135deg, #f9fafb, #f3f4f6) -->
                    <!-- Dark: #1a1a1a → #0f0f0f                      -->
                    <!-- ════════════════════════════════════════════ -->
                    <Border Name="StagesCard" Grid.Column="1"
                            CornerRadius="16" Padding="24"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Stroke}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="{DynamicResource SurfaceMedium}" Offset="0" />
                                <GradientStop Color="{DynamicResource CardSurface}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="16">
                            <!-- Header (dynamic: Release Schedule / Payment Schedule) -->
                            <StackPanel Spacing="4">
                                <TextBlock Classes="Size-L" Text="{Binding ScheduleTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextStrong}" />
                                <TextBlock Classes="Size-13" Text="{Binding ScheduleDescription}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Stage/Payment rows -->
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fp:InvestStageRow">
                                        <!-- Vue: padding 14px, bg white, border-radius 10px, border 1px solid #e5e7eb -->
                                        <Border CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource Stroke}"
                                                BorderThickness="1">
                                            <Grid Classes="StageRow" RowDefinitions="Auto,Auto">
                                                <Grid Classes="StageTopRow" Grid.Row="0" ColumnDefinitions="*,Auto">
                                                    <!-- Stage/Payment label (bound, no code-behind needed) -->
                                                    <TextBlock Grid.Column="0"
                                                               Classes="StageLabel Size-S"
                                                               Text="{Binding LabelText}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextStrong}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip.Tip="{Binding LabelText}" />
                                                    <!-- Percentage pill: hidden for subscription -->
                                                    <Border Grid.Column="1"
                                                            Classes="StagePercentage"
                                                            CornerRadius="4"
                                                            Padding="8,2"
                                                            Margin="8,0,0,0"
                                                            MinWidth="48"
                                                            Background="{DynamicResource BadgeApprovedBackground}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding !IsSubscriptionRow}">
                                                        <TextBlock Classes="Size-XS" Text="{Binding Percentage}" FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   Foreground="{DynamicResource StageAmountGreen}" />
                                                    </Border>
                                                </Grid>
                                                <Grid Classes="StageBottomRow" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                    <!-- Date below, independent from the percentage column width. -->
                                                    <TextBlock Grid.Column="0"
                                                               Classes="StageDate Size-XS"
                                                               Text="{Binding ReleaseDate}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip.Tip="{Binding ReleaseDate}" />
                                                    <!-- Amount display (bound, no code-behind needed) -->
                                                    <TextBlock Grid.Column="1"
                                                               Classes="StageAmount Size-S"
                                                               Text="{Binding AmountDisplayText}" FontWeight="Bold"
                                                               Foreground="{DynamicResource StageAmountGreen}"
                                                               HorizontalAlignment="Right"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════ -->
                    <!-- COLUMN 3: Transaction Details Card            -->
                    <!-- Vue: standard card (white bg, border-radius 16px, padding 24px) -->
                    <!-- Subscription: "Amount to Subscribe" + sats   -->
                    <!-- ════════════════════════════════════════════ -->
                    <Border Name="TransactionCard" Grid.Column="2"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource ItemShadow}">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="Size-L" Text="Transaction Details" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrong}"
                                       Margin="0,0,0,20" />

                            <!-- Project ID row: Vue code container -->
                            <StackPanel Spacing="6" Margin="0,0,0,16">
                                <TextBlock Classes="Size-13" Text="Project ID" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                                <Border CornerRadius="8" Padding="10,10,14,10"
                                        Background="{DynamicResource SurfaceMedium}"
                                        BorderBrush="{DynamicResource Stroke}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="Size-XXS" Grid.Column="0"
                                                   Text="{Binding ProjectId}"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   Foreground="{DynamicResource TextStrong}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding ProjectId}" />
                                        <Button Grid.Column="1" Name="CopyProjectIdButton" Classes="Unstyled"
                                                Cursor="Hand" Padding="4" Margin="8,0,0,0"
                                                Background="Transparent">
                                            <i:Icon Value="fa-solid fa-copy" FontSize="14" Foreground="{DynamicResource TextMuted}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,12" />

                            <!-- Investment Amount / Amount to Subscribe -->
                            <!-- Vue: subscription "Amount to Subscribe" shown in Sats -->
                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                <TextBlock Classes="Size-13" Text="{Binding TransactionAmountLabel}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Classes="Size-M" Text="{Binding TransactionAmountValue}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StageAmountGreen}" />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,12" />

                            <!-- Miner Fee -->
                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                <TextBlock Classes="Size-13" Text="Miner Fee (estimated)" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Classes="Size-S" Text="{Binding MinerFee}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextStrong}" />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,12" />

                            <!-- Angor Fee -->
                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                <TextBlock Classes="Size-13" Text="Angor Fee" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                                <Panel>
                                    <TextBlock Classes="Size-S" Text="{Binding AngorFee}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextStrong}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Classes="Size-13" Text="{Binding AngorFeeAmount}"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Right" />
                                </Panel>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,12" />

                            <!-- Total -->
                            <Panel Margin="0,4,0,0">
                                <TextBlock Classes="Size-15" Text="Total" FontWeight="Bold"
                                           Foreground="{DynamicResource TextStrong}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <TextBlock Classes="Size-M" Text="{Binding TotalAmount}" FontWeight="Bold"
                                           Foreground="{DynamicResource StageAmountGreen}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Panel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── MOBILE INLINE SUBMIT BUTTON (hidden on desktop, shown on compact) ── -->
                <!-- Vue: .invest-submit-btn { display:none → display:flex at ≤768px } -->
                <Button Name="MobileSubmitButton" Classes="Unstyled"
                        CornerRadius="8" Padding="16,16"
                        Margin="16,16,16,0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        IsVisible="False"
                        IsEnabled="{Binding CanSubmit}"
                        IsHitTestVisible="{Binding CanSubmit}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#2D5A3D" Offset="0" />
                            <GradientStop Color="#4A8F5F" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <i:Icon Value="fa-brands fa-bitcoin"
                               FontSize="18" Foreground="White" VerticalAlignment="Center"
                               IsVisible="{Binding IsNotSubscription}" />
                        <i:Icon Value="fa-solid fa-arrows-rotate" FontSize="18"
                               Foreground="White" VerticalAlignment="Center"
                               IsVisible="{Binding IsSubscription}" />
                        <TextBlock Classes="Size-M" Text="{Binding Project.ActionButtonText}" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Bottom spacer: footer height (~68px) + gap (24px) = 92px -->
                <Panel Name="BottomSpacer" Height="92" />
            </StackPanel>
        </ScrollViewer>

        <!-- Modals (Wallet Selector, Invoice, Success) are now rendered at shell level -->
        <!-- via InvestModalsView pushed to ShellViewModel.ShowModal() -->
    </Panel>
</UserControl>
