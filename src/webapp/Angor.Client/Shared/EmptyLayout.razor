@inherits LayoutComponentBase
@using Angor.Shared.Services
@inject INetworkService _networkService
@inject NavigationManager _navManager
@inject IJSRuntime JS

<div class="hub-page" data-theme="@HubTheme">
    <CascadingValue Value="this">
        @Body
    </CascadingValue>
</div>

@code {
    private string HubTheme = "dark";
    public bool IsLight => HubTheme == "light";

    public async Task ToggleThemeAsync()
    {
        HubTheme = IsLight ? "dark" : "light";
        await JS.InvokeVoidAsync("angorPayment.setTheme", HubTheme);
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        // Standalone layout — perform the network/settings initialization
        // MainLayout normally does, before any child component renders.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(_navManager.Uri).Query);
        HubTheme = query["theme"] == "light" ? "light" : "dark";
        string? requestedNetwork = query["network"] is "Main" or "Angornet" ? query["network"] : null;
        _networkService.CheckAndSetNetwork(_navManager.Uri.ToLower(), requestedNetwork);
        _networkService.AddSettingsIfNotExist();
        _ = _networkService.CheckServices(true);
    }
}
